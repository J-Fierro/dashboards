# "mock" reads data/mock/*.json (Ads Manager CSV export).
# "meta" calls the Meta Marketing API live. Switch once the token exists.
DATA_SOURCE=mock

# Meta Marketing API (only needed when DATA_SOURCE=meta)
META_ACCESS_TOKEN=
META_API_VERSION=v25.0

# Google service account for reading the lead sheets.
# Without these, the app falls back to data/fixtures/*.json.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file, keeping the \n sequences.
GOOGLE_PRIVATE_KEY=

# Access links. Generate each value with: openssl rand -hex 32
# Without SESSION_SECRET, production shows "Kein Zugriff" to everyone.
SESSION_SECRET=
# Opens every dashboard and the client list at "/".
ADMIN_TOKEN=
# One per client: ACCESS_ + the client slug in capitals, dashes as underscores.
ACCESS_MISTER_MARKETING=
