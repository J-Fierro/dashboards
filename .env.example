# "mock" reads data/mock/*.json (Ads Manager CSV export).
# "meta" calls the Meta Marketing API live.
DATA_SOURCE=mock

# Meta Marketing API (only needed when DATA_SOURCE=meta)
META_ACCESS_TOKEN=
META_API_VERSION=v27.0

# Google service account for reading the lead sheets.
# Without these, the app falls back to data/fixtures/*.json.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file, keeping the \n sequences.
GOOGLE_PRIVATE_KEY=

# Optional extra secret mixed into the login cookies. Changing it logs everyone out.
SESSION_SECRET=

# Login passwords (see README "Login"). Client: PASSWORD_ + slug in capitals, "-" -> "_".
ADMIN_PASSWORD=
PASSWORD_MISTER_MARKETING=
